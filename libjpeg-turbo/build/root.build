# Emulate the libjpeg v7 or v8 API/ABI instead of v6b (upstream's WITH_JPEG7
# and WITH_JPEG8). Note that either makes the library backward-incompatible
# with libjpeg v6b. If both are true, then the latest is emulated.
#
config [bool] config.libjpeg_turbo.jpeg7 ?= false
config [bool] config.libjpeg_turbo.jpeg8 ?= false

# Build the SIMD extensions on the targets where this package supports them
# (upstream's WITH_SIMD): x86-64 and i386 (which require NASM) and AArch64.
#
config [bool] config.libjpeg_turbo.simd ?= true

# Uncomment to suppress warnings coming from external libraries.
#
#c.internal.scope = current

using in

using c

h{*}: extension = h
c{*}: extension = c

# The test target for cross-testing (running tests under Wine, etc).
#
test.target = $c.target
